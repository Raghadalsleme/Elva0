{
  "name": "@salla.sa/ui-google-map-render",
  "description": "Framework-agnostic Google Maps web components using Lit - lightweight with runtime library loading",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "web-component",
    "lit",
    "google-maps",
    "maps",
    "marker",
    "framework-agnostic",
    "lightweight"
  ],
  "author": "Salla",
  "license": "MIT",
  "peerDependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@salla.sa/ui-address-autocomplete-widget": "^1.0",
    "lit": "^3.3.2"
  },
  "peerDependenciesMeta": {
    "@googlemaps/markerclusterer": {
      "optional": true
    },
    "@salla.sa/ui-address-autocomplete-widget": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@salla.sa/ui-address-autocomplete-widget": "^1.0",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "customElements": "custom-elements.json",
  "version": "1.2.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --emitDeclarationOnly && vite build --config vite.config.ts",
    "build:scoped": "tsc --emitDeclarationOnly && vite build --config vite.config.ts",
    "preview": "vite preview",
    "analyze": "cem analyze --litelement",
    "docs": "cem analyze --litelement"
  }
}