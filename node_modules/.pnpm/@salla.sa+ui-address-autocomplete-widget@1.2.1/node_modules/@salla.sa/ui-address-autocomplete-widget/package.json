{
  "name": "@salla.sa/ui-address-autocomplete-widget",
  "description": "Framework-agnostic address autocomplete web component using Lit",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "web-component",
    "lit",
    "address",
    "autocomplete",
    "google-places",
    "framework-agnostic"
  ],
  "author": "Salla",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "customElements": "custom-elements.json",
  "version": "1.2.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --emitDeclarationOnly && vite build --config vite.config.ts",
    "build:scoped": "tsc --emitDeclarationOnly && vite build --config vite.config.ts",
    "preview": "vite preview",
    "analyze": "cem analyze --litelement",
    "docs": "cem analyze --litelement"
  }
}