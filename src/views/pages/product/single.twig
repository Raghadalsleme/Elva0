{#
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|------------------------------------------------------------------------|
| page                                   | object                      |                                                                        |
| page.title                             | string                      | *could be html                                                         |
| page.slug                              | string                      | ex: "cat.show"                                                         |
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.weight                         | ?string                     |                                                                        |
| product.calories                       | ?float                      |                                                                        |
| product.sku                            | ?string                     |                                                                        |
| product.barcode                        | ?string                     |                                                                        |
| product.shows_sku                      | bool                        | SKU row belongs on the page (selected, and a value exists somewhere)   |
| product.shows_barcode                  | bool                        | Barcode row belongs on the page (selected, and a value exists)         |
| product.rating                         | ?Rating                     |                                                                        |
| product.rating.count                   | int                         |                                                                        |
| product.rating.stars                   | int                         |                                                                        |
| product.price                          | float                       | can be string too `-`, when merchant doesn't want to show zero         |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.quantity                       | ?int                        | if it's null, means it's unlimited                                     |
| product.sold_quantity                  | int                         |                                                                        |
| product.max_quantity                   | int                         |                                                                        |
| product.discount_ends                  | ?date                       |                                                                        |
| product.is_taxable                     | bool                        | Is the tax included in the price                                       |
| product.category                       | ?Category                   |                                                                        |
| product.category.name                  | string                      |                                                                        |
| product.category.url                   | string                      |                                                                        |
| product.image                          | object                      |                                                                        |
| product.image.url                      | string                      |                                                                        |
| product.image.alt                      | ?string                     |                                                                        |
| product.images                         | array                       |                                                                        |
| product.images[].id                    | int                         |                                                                        |
| product.images[].url                   | string                      |                                                                        |
| product.images[].alt                   | ?string                     |                                                                        |
| product.images[].video_url             | ?string                     |                                                                        |
| product.images[].video_type            | ?string                     | 'video' 'youtube'                                                      |
| product.images[].type                  | string                      | `image` `video`                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.brand.id                       | int                         |                                                                        |
| product.brand.url                      | ?string                     |                                                                        |
| product.brand.name                     | ?string                     |                                                                        |
| product.brand.logo                     | ?string                     |                                                                        |
| product.tags                           | ?Tags[] *Collection         |                                                                        |
| product.tags[].name                    | string                      |                                                                        |
| product.tags[].url                     | string                      |                                                                        |
| product.options                        | ProductOption[] *Collection | @see views/pages/partials/product/options.twig                         |
| product.notify_availability            | ?object                     | does product outOfStock & can visitor subscribe to notify availability |
| product.notify_availability.channels   | array                       | ex: ['sms', 'email']                                                   |
| product.notify_availability.subscribed | bool                        | Does user subscribed before                                            |
| product.donation                       | ?ProductDonation            |                                                                        |
| product.donation.target_message        | ?string                     | Message if reached to target or target expired                         |
| product.donation.collected_amount      | float                       |                                                                        |
| product.donation.target_amount         | float                       |                                                                        |
| product.donation.target_percent        | float                       |                                                                        |
| product.donation.target_end_date       | ?Date                       |                                                                        |
| product.donation.can_donate            | bool                        | `true` When there is no campaign or (target not reached & not expired) |
| product.has_read_more                  | bool                        |                                                                        |
| product.can_add_note                   | bool                        |                                                                        |
| product.can_show_remained_quantity     | bool                        |                                                                        |
| product.can_show_sold                  | bool                        |                                                                        |
| product.can_upload_file                | bool                        |                                                                        |
| product.has_custom_form                | bool                        | Is it for  `Food` or `Custom Service` product                          |
| product.has_metadata                   | bool                        |                                                                        |
| product.has_options                    | bool                        |                                                                        |
| product.is_on_sale                     | bool                        | Product has discounted price                                           |
| product.is_hidden_quantity             | bool                        | The quantity is hidden by merchant, or product not available           |
| product.is_available                   | bool                        |                                                                        |
| product.is_in_wishlist                 | bool                        |                                                                        |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.is_require_shipping            | bool                        |                                                                        |
| product.base_currency_price            | float                       | product.price with base currency (SAR)                                 |
| product.discount_percentage            | ?string                     | ex: "20%"                                                              |
| product.has_3d_image                   | bool                        |                                                                        |
| product.has_size_guide                 | bool                        |                                                                        |
| product.is_giftable                    | bool                        |                                                                        |
| product.add_to_cart_label              | string                      |                                                                        |
| product.currency                       | string                      |                                                                        |
#}
{#
  ELVA product page
  - Style: "stage" (gallery on a plum spotlight stage, details on a cream hang tag) or "light"
  - Gallery: "stack" (editorial image column on desktop, swipe slider on phones) or "slider" (carousel + thumbnails)
  - Sticky information column with one price block, options, quantity and add to cart
  - Accordions: product details, shipping, returns (texts from theme settings)
#}
{% extends "layouts.master" %}
{% block content %}
    {% set gallery_layout = theme.settings.get('elva_gallery_layout', 'stack') %}
    {% set has_many_images = product.images|length > 1 %}
    {% set use_stack = gallery_layout == 'stack' and has_many_images %}
    {% set shipping_text = theme.settings.get('elva_pdp_shipping', '') %}
    {% set returns_text = theme.settings.get('elva_pdp_returns', '') %}
    {% set related_title = theme.settings.get('elva_related_title', '') %}
    {% set pdp_style = theme.settings.get('elva_pdp_style', 'stage') == 'light' ? 'light' : 'stage' %}
    {# discount badge text comes ready from Salla, ex: "20%" #}
    {% set discount = product.is_on_sale and product.discount_percentage ? product.discount_percentage : '' %}

    {#
        Hook: product.single.before_product_info
        Fires before the main product information section (images, title, price, etc.).
    #}
    <div class="s-blocks-wrapper s-before-product-info !mt-0">{% hook 'product.single.before_product_info' %}</div>

    <div class="elva-pdp-wrap elva-pdp-wrap--{{ pdp_style }}">
    {% if theme.settings.get('product_show_breadcrumbs', true) %}
      <div class="container container--breadcrumbs">
          <nav class="breadcrumbs w-full py-5">
              <salla-breadcrumb></salla-breadcrumb>
          </nav>
      </div>
    {% endif %}

    <div class="container container--product-details elva-pdp elva-pdp--{{ use_stack ? 'stack' : 'slider' }}">
        <div class="elva-pdp__grid" id="product-{{ product.id }}">

            {# ---------------- Gallery ---------------- #}
            <div class="elva-pdp__gallery">
                <div class="elva-pdp__badges">
                    {% if product.promotion_title %}
                        <span class="elva-pdp__badge">{{ product.promotion_title }}</span>
                    {% endif %}
                    {% if discount %}
                        <span class="elva-pdp__badge elva-pdp__badge--sale" dir="ltr">-{{ discount|replace({'-': '', '%': ''}) }}%</span>
                    {% endif %}
                </div>

                {% if use_stack %}
                    <div class="elva-pdp__stack" data-testid="store-product-image-stack">
                        {% for image in product.images %}
                            <a data-fslightbox="product_stack_{{ product.id }}"
                               data-type="{{ image.video_type ?? 'image' }}"
                               href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                               aria-label="{{ product.name }} {{ loop.index }}"
                               class="elva-pdp__shot{{ loop.first ? ' elva-pdp__shot--lead' : '' }}{{ image.video_url ? ' elva-pdp__shot--video' : '' }}">
                                <img src="{{ image.url }}" alt="{{ image.alt ? image.alt : product.name }}"
                                     {% if loop.first %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="elva-pdp__slider{{ use_stack ? ' elva-pdp__slider--phone' : '' }}">
                    <salla-slider
                            data-testid="store-product-image-slider"
                            id="details-slider-{{ product.id }}"
                            class="details-slider image-slider"
                            data-images='{{ product.images|json_encode }}'
                            type="thumbs"
                            thumbs-config='{"slidesPerView": 5, "spaceBetween": 0, "watchSlidesProgress": true, "watchOverflow": true, "breakpoints": {"768": {"slidesPerView": 6, "spaceBetween": 0}}}'
                            loop="false"
                            auto-height
                            listen-to-thumbnails-option
                            show-thumbs-controls="false">

                        {% if product.calories %}
                            <div class="elva-pdp__calories">
                                <span>{{ product.calories }}</span>
                                <small>{{ trans('pages.products.calories') }}</small>
                            </div>
                        {% endif %}

                        <div slot="items">
                            {% for image in product.images %}
                                {% if image.three_d_image_url %}
                                    <model-viewer style="min-height: 500px;" class="swiper-slide model-entry w-full h-full"
                                        loading="eager" camera-controls
                                        touch-action="pan-y" auto-rotate
                                        poster="{{ image.url }}"
                                        src="{{ image.three_d_image_url }}"
                                        shadow-intensity="1" alt="{{ image.alt }}">
                                    </model-viewer>
                                {% else %}
                                    <a data-fslightbox="product_{{ product.id }}"
                                       data-img-id="{{ image.id }}"
                                       data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                                       data-caption="{{ image.alt }}"
                                       data-infinite="false"
                                       data-type="{{ image.video_type ?? 'image' }}"
                                       href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                       aria-label="{{ product.name }}"
                                       class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                        <img id="{{ image.id }}" src="{{ image.url }}"
                                             {% if loop.first and not use_stack %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}
                                             alt="{{ image.alt ? image.alt : product.name }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size', 'cover') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    </a>
                                {% endif %}
                            {% endfor %}
                        </div>

                        {% if has_many_images %}
                            <div data-testid="store-product-thumbnails" slot="thumbs">
                                {% for image in product.images %}
                                    <div class="slide--one-fourth {{ image.video_url?'video-entry':'' }} {{ image.three_d_image_url?'model-entry':'' }}" data-caption="{{ image.alt }}">
                                        <img src="{{ image.url }}"
                                             loading="{{ loop.index < 5 ? 'eager' : 'lazy' }}"
                                             class="object-cover w-full h-full"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </salla-slider>
                </div>
            </div>

            {# ---------------- Information ---------------- #}
            <div class="elva-pdp__info">
                <div class="elva-pdp__sticky{{ pdp_style == 'stage' ? ' elva-tag' : '' }}">
                    {% if pdp_style == 'stage' %}<span class="elva-tag__eyelet" aria-hidden="true"></span>{% endif %}
                    {% hook 'product:single.description.start' %}

                    <div class="elva-pdp__eyebrow-row">
                        {% if product.category %}
                            <a class="elva-pdp__eyebrow" href="{{ product.category.url }}">{{ product.category.name }}</a>
                        {% endif %}
                        {% if product.brand.name %}
                            <a class="elva-pdp__brand" href="{{ product.brand.url }}" title="{{ product.brand.name }}">
                                {% if product.brand.logo %}
                                    <img src="{{ product.brand.logo }}" alt="{{ product.brand.name }}" loading="lazy">
                                {% else %}
                                    {{ product.brand.name }}
                                {% endif %}
                            </a>
                        {% endif %}
                    </div>

                    <h1 data-testid="store-product-title" class="elva-pdp__title">{{ product.name }}</h1>

                    {% if product.subtitle %}
                        <h2 class="elva-pdp__subtitle product-entry__sub-title">{{ product.subtitle }}</h2>
                    {% endif %}

                    {% if product.rating %}
                        <salla-rating-stars data-testid="store-product-rating" class="elva-pdp__rating" value="{{ product.rating.stars }}"
                                            reviews="{{ product.rating.count }}"></salla-rating-stars>
                    {% endif %}

                    {# Price: the only price block on the page (product.js updates it when options change) #}
                    <div data-testid="store-product-price" class="elva-pdp__price">
                        <div class="price-wrapper flex flex-wrap items-baseline gap-3">
                            <div class="{{ product.is_on_sale ? '' : 'hidden' }} price_is_on_sale flex items-baseline gap-3">
                                <span class="total-price elva-pdp__price-now">{{ product.sale_price|money }}</span>
                                <span class="before-price elva-pdp__price-was">{{ product.regular_price|money }}</span>
                            </div>
                            <div class="starting-or-normal-price {{ product.is_on_sale ? 'hidden' : 'flex' }} items-baseline gap-3">
                                {% if product.starting_price %}
                                    <span class="starting-price-title elva-pdp__price-from">{{ trans('pages.products.starting_price') }}</span>
                                {% endif %}
                                <span class="total-price elva-pdp__price-now">{{ product.starting_price ? product.starting_price|money : product.price|money }}</span>
                            </div>
                        </div>
                        <div data-testid="store-product-out-of-stock" class="out-of-stock hidden elva-pdp__out">{{ trans('pages.products.out_of_stock') }}</div>
                        {% if product.is_taxable %}
                            <small class="elva-pdp__tax">{{ trans('pages.products.tax_included') }}</small>
                        {% endif %}
                    </div>

                    {# Installment Methods #}
                    <salla-installment data-testid="store-product-installment" price="{{ product.price }}"></salla-installment>

                    {% if product.sold_quantity or product.can_show_remained_quantity %}
                        <div class="elva-pdp__stock">
                            {% if product.sold_quantity %}
                                <span><i class="sicon-fire" aria-hidden="true"></i> {{ trans('pages.products.sold') }} {{ pluralize('pages.products.sold_times', product.sold_quantity)|raw }}</span>
                            {% endif %}
                            {% if product.can_show_remained_quantity %}
                                <span><i class="sicon-box-bankers" aria-hidden="true"></i> {{ trans('pages.products.remained') }} {{ product.quantity }}</span>
                            {% endif %}
                        </div>
                    {% endif %}

                    {% hook 'product:single.description' %}

                    {% if product.show_availability %}
                        <button type="button" class="elva-pdp__line-btn"
                                onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })">
                            <span class="sicon-location" aria-hidden="true"></span>
                            <span>{{ trans('pages.products.availability') }}</span>
                            <span class="elva-pdp__line-btn-cta">{{ trans('pages.products.select_branch') }}</span>
                        </button>
                    {% endif %}

                    {% if product.digital_files_settings %}
                        <digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>
                    {% endif %}

                    <form data-testid="store-product-form" class="form product-form elva-pdp__form" enctype="multipart/form-data" method="post"
                          onsubmit="return salla.form.onSubmit('cart.addItem', event)">
                        <input type="hidden" name="id" value="{{ product.id }}">

                        {% hook 'product:single.form.start' %}

                        {% include 'pages.partials.product.options' %}

                        {% hook 'product:single.form.end' %}

                        {% if product.has_preorder_campaign %}
                            <section class="elva-pdp__preorder">
                                <salla-count-down data-testid="store-product-preorder-countdown" pre-order='{{ product.preorder|json_encode}}' boxed labeled></salla-count-down>
                            </section>
                        {% endif %}

                        <section class="sticky-product-bar elva-pdp__buy">
                            {% if product.is_hidden_quantity or product.type == 'booking' %}
                                <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
                            {% else %}
                                <div class="sticky-product-bar__quantity elva-pdp__qty">
                                    <label class="form-label sr-only">{{ trans('pages.products.quantity') }}</label>
                                    <salla-quantity-input data-testid="store-product-quantity" max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="{{ trans('pages.products.quantity') }}"></salla-quantity-input>
                                </div>
                            {% endif %}
                            <salla-add-product-button
                                    data-testid="store-product-add-to-cart"
                                    {{ product.can_quick_buy ? 'quick-buy' : '' }}
                                    {{ theme.settings.get('sticky_add_to_cart') ? ' support-sticky-bar' : '' }}
                                    {{ product.is_require_shipping ? 'required-shipping' : '' }}
                                    {{ product.has_preorder_campaign ? 'has-pre-order' : '' }}
                                    amount="{{ product.base_currency_price }}"
                                    class="sticky-product-bar__btn elva-pdp__add"
                                    product-status="{{ product.status }}"
                                    product-type="{{ product.type }}"
                                    product-id="{{ product.id }}"
                                    loader-position="end"
                                    type="submit"
                                    width="wide"
                                    {% if product.notify_availability %}
                                        {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                        channels="{{ product.notify_availability.channels|join(',') }}"
                                        subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
                                        {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                    {% endif %}>
                                {{ product.add_to_cart_label }}
                            </salla-add-product-button>
                            <salla-button
                                    data-testid="store-product-wishlist-btn"
                                    class="btn--wishlist animated elva-pdp__wish"
                                    data-id="{{ product.id }}"
                                    onclick="salla.wishlist.toggle('{{ product.id }}')"
                                    shape="icon"
                                    fill="outline"
                                    color="light"
                                    aria-label="add to wishlist">
                                <i class="sicon-heart"></i>
                            </salla-button>
                        </section>

                        {% if product.is_giftable %}
                            <salla-gifting data-testid="store-product-gifting" class="mt-5" widget-subtitle="{{ gifting_intro }}" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : '' }}></salla-gifting>
                        {% endif %}
                    </form>

                    {# Accordions #}
                    <div class="elva-pdp__accordions">
                        <details class="elva-acc" open>
                            <summary class="elva-acc__head">{{ trans('blocks.elva.product_details') }}</summary>
                            <div class="elva-acc__body">
                                <div data-testid="store-product-description" class="product__description article--main">
                                    {{ product.description|replace({"&nbsp;":"\n"})|raw }}
                                </div>

                                {% if product.shows_sku %}
                                    <div class="product-sku-wrapper elva-pdp__meta {% if not product.sku %}hidden{% endif %}">
                                        <span>{{ trans('pages.products.sku') }}</span>
                                        <span class="text-unicode break-all product-sku">{{ product.sku }}</span>
                                    </div>
                                {% endif %}
                                {% if product.shows_barcode %}
                                    <div class="product-barcode-wrapper elva-pdp__meta {% if not product.barcode %}hidden{% endif %}">
                                        <span>{{ trans('pages.products.barcode') }}</span>
                                        <span class="text-unicode break-all product-barcode">{{ product.barcode }}</span>
                                    </div>
                                {% endif %}

                                {% if product.tags|length and theme.settings.get('show_tags', true) %}
                                    <div class="elva-pdp__tags">
                                        {% for tag in product.tags %}
                                            <a href="{{ tag.url }}">{{ tag.name }}</a>
                                        {% endfor %}
                                    </div>
                                {% endif %}

                                {% if product.has_metadata %}
                                    <salla-metadata data-testid="store-product-metadata"></salla-metadata>
                                {% endif %}
                            </div>
                        </details>

                        {% if shipping_text|trim %}
                            <details class="elva-acc">
                                <summary class="elva-acc__head">{{ trans('blocks.elva.shipping') }}</summary>
                                <div class="elva-acc__body">{{ shipping_text|nl2br }}</div>
                            </details>
                        {% endif %}

                        {% if returns_text|trim %}
                            <details class="elva-acc">
                                <summary class="elva-acc__head">{{ trans('blocks.elva.returns') }}</summary>
                                <div class="elva-acc__body">{{ returns_text|nl2br }}</div>
                            </details>
                        {% endif %}
                    </div>

                    <div class="elva-pdp__share">
                        <salla-social-share data-testid="store-product-social-share"></salla-social-share>
                    </div>

                    {% hook 'product:single.description.end' %}
                    <salla-quick-order data-testid="store-product-quick-order" class="mt-5 block"></salla-quick-order>
                </div>
            </div>
        </div>
    </div>
    </div>{# /.elva-pdp-wrap #}

    <div class="container">
        <salla-offer data-testid="store-product-offer"></salla-offer>
    </div>

    {#
        Hook: product.single.before_customer_reviews
    #}
    <div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>

    {% if store.settings.rating.show_on_product %}
        <div class="elva-pdp__reviews">
            <salla-comments data-testid="store-product-comments" item-id="{{ product.id }}" type="product"></salla-comments>
        </div>
    {% endif %}

    {#
        Hook: product.single.before_product_recommendations
    #}
    <div class="s-blocks-wrapper s-before-related">{% hook 'product.single.before_product_recommendations' %}</div>

    <section class="container elva-pdp__related">
        <salla-products-slider data-testid="store-product-related" source="related" source-value="{{ product.id }}"
                               includes='["images"]'
                               block-title="{{ related_title|trim ? related_title : trans('pages.products.similar_products') }}" display-all-url></salla-products-slider>
    </section>

    {#
        Hook: product.single.after_product_recommendations
    #}
    <div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}
