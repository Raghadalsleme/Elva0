{#
| Variable                   | Type        | Description                                                          |
|----------------------------|-------------|----------------------------------------------------------------------|
| page                       | object      |                                                                      |
| page.title                 | string      | *could be html                                                       |
| page.slug                  | string      | ex: "cat.show"                                                       |
| category                   | ?Category   |                                                                      |
| category.name              | string      |                                                                      |
| category.url               | string      |                                                                      |
| category.sub_categories    | ?Category[] |                                                                      |
| category.image             | ?string     |                                                                      |
| filters                     | bool        | is filters allowed here or not                                        |
| sort_options[]             | SortList[]  |                                                                      |
| sort_options[].id          | string      | ourSuggest, bestSell, topRated, priceFromTopToLow, priceFromLowToTop |
| sort_options[].name        | string      |                                                                      |
| sort_options[].is_selected | bool        | Is current page sorted by it                                         |
| search_query               | ?string     |                                                                      |
#}
{#
  ELVA category page
  - Category banner (uses the category image when there is one)
  - Sub-category chips
  - Toolbar: filter button, column switcher, sorting
  - Filters as a sidebar or a drawer (theme setting)
#}
{% extends "layouts.master" %}
{% block content %}
	{% set filters_style = theme.settings.get('elva_filters_style', 'sidebar') %}
	{% set default_cols = theme.settings.get('elva_grid_columns', '3') %}
	{% set show_banner = theme.settings.get('elva_category_banner', true) %}
	{% set cat_image = category.image is defined ? category.image : null %}

	{% if theme.settings.get('product_index_show_breadcrumbs', true) %}
		<div class="container container--breadcrumbs">
			<nav class="breadcrumbs w-full py-5">
				<salla-breadcrumb></salla-breadcrumb>
			</nav>
		</div>
	{% endif %}

	{% if show_banner %}
		<header class="elva-cat-hero{{ cat_image ? ' elva-cat-hero--image' : '' }}">
			{% if cat_image %}
				<img class="elva-cat-hero__img" src="{{ cat_image }}" alt="" loading="eager" fetchpriority="high">
				<span class="elva-cat-hero__shade" aria-hidden="true"></span>
			{% endif %}
			<div class="container elva-cat-hero__inner">
				<h1 class="elva-cat-hero__title" id="page-main-title">{{ page.title|raw }}</h1>
				<div class="elva-ornament" aria-hidden="true"><span></span></div>
			</div>
		</header>
	{% endif %}

	{% if category.sub_categories is defined and category.sub_categories|length %}
		<nav class="container elva-cat-chips" aria-label="{{ page.title|striptags }}">
			{% for sub in category.sub_categories %}
				<a class="elva-cat-chips__item" href="{{ sub.url }}">
					{% if sub.image %}<img src="{{ sub.image }}" alt="" loading="lazy">{% endif %}
					<span>{{ sub.name }}</span>
				</a>
			{% endfor %}
		</nav>
	{% endif %}

	{#
    Hook: product.index.before_products_group_with_filter
  #}
	<div class="s-blocks-wrapper s-before-products-list !mt-0">{% hook 'product.index.before_products_group_with_filter' %}</div>

	<div class="container container--products-list elva-cat elva-cat--{{ filters_style == 'drawer' ? 'drawer' : 'sidebar' }}{{ filters ? ' elva-cat--has-filters' : '' }}"
	     data-cols="{{ default_cols in ['2', '3', '4'] ? default_cols : '3' }}" data-filters-style="{{ filters_style }}">
		{% if filters %}
			<button class="btn--close-sm close-filters sicon-cancel hidden" aria-label="close"></button>
			<salla-filters data-testid="store-products-filters" class="elva-cat__filters" id="filters-menu"></salla-filters>
		{% endif %}

		<div class="main-content elva-cat__main">
			<div class="elva-cat__toolbar">
				{% if not show_banner %}
					<h1 class="elva-cat__title" id="page-main-title">{{ page.title|raw }}</h1>
				{% endif %}

				<div class="elva-cat__tools">
					{% if filters %}
						<a data-testid="store-products-filters-mobile-trigger" href="#filters-menu" class="filters-trigger elva-cat__filter-btn">
							<i class="sicon-filter" aria-hidden="true"></i>
							<span>{{ trans('blocks.elva.filter') }}</span>
						</a>
					{% endif %}

					<div class="elva-cat__cols" role="group" aria-label="{{ trans('blocks.elva.grid_view') }}">
						{% for n in [2, 3, 4] %}
							<button type="button" class="elva-cat__col-btn" data-elva-cols="{{ n }}" aria-label="{{ n }}" aria-pressed="false">
								<span class="elva-cat__col-icon" aria-hidden="true">{% for i in range(1, n) %}<i></i>{% endfor %}</span>
							</button>
						{% endfor %}
					</div>

					{% if sort_options|length %}
						<div class="elva-cat__sort">
							<label class="sr-only" for="product-filter">{{ trans('pages.categories.sorting') }}</label>
							<select id="product-filter" class="form-input">
								{% for sort in sort_options %}
									<option value="{{ sort.id }}" {{ sort.is_selected?'selected':'' }}>{{ sort.name }}</option>
								{% endfor %}
							</select>
						</div>
					{% endif %}
				</div>
			</div>

			{% hook 'product:index.items.start' %}

			{% set sort_list = sort_options|default([]) %}
			{% set first_sort = sort_list|first %}
			{% set has_selected_sort = sort_list|filter(sort => sort.is_selected)|length %}
			{% set fallback_sort = (sort_list|length and not has_selected_sort and first_sort.id != 'ourSuggest') ? first_sort.id : '' %}

			<h2 class="sr-only">{{ trans('blocks.elva.products') }}</h2>
			<div class="flex">
				<salla-products-list data-testid="store-products-list" class="flex-1 min-w-0 elva-cat__list" source="{{ page.slug }}" source-value="{{ page.id }}" sort-by="{{ fallback_sort }}" includes='["images"]' {{ filters ?'filters-Results':'' }}></salla-products-list>
			</div>

			{% hook 'product:index.items.end' %}
		</div>
	</div>

	{#
    Hook: product.index.after_products_group_with_filter
  #}
	<div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>

	{% if store.settings.category.testimonial_enabled %}
		{% component 'home.testimonials' %}
	{% endif %}

	{#
    Hook: product.index.after_testimonials
  #}
	<div class="s-blocks-wrapper s-after-testimonials">{% hook 'product.index.after_testimonials' %}</div>
{% endblock %}

{% block scripts %}
	<script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
