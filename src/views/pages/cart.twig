{#
| Variable                                          | Type                | Description                                                    |
|---------------------------------------------------|---------------------|----------------------------------------------------------------|
| page                                              | object              |                                                                |
| page.title                                        | string              |                                                                |
| page.slug                                         | string              |                                                                |
| cart                                              | Cart                |                                                                |
| cart.id                                           | string              | Unique string for current cart                                 |
| cart.is_require_shipping                          | bool                | Does one of cart items require shipping?                       |
| cart.has_shipping                                 | bool                | Does shipping company selected?                                |
| cart.real_shipping_cost                           | float               | Shipping cost can become free by an offer, coupon              |
| cart.sub_total                                    | float               | The sum of items price without shipping or other costs         |
| cart.discount                                     | float               | final discount                                                 |
| cart.coupon                                       | ?string             |                                                                |
| cart.total                                        | float               |                                                                |
| cart.tax_amount                                   | float               | Calculate Tax amount                                                               |
| cart.free_shipping_bar                            | ?object             |                                                                |
| cart.free_shipping_bar.minimum_amount             | float               | how much cart total should be to apply free shipping ex: 1000  |
| cart.free_shipping_bar.has_free_shipping          | bool                | true when `cart.free_shipping_bar.percent==100`                |
| cart.free_shipping_bar.percent                    | float               | `0 - 100`                                                      |
| cart.free_shipping_bar.remaining                  | float               | `830`                                                          |
| cart.items                                        | CartItem[]          |                                                                |
| cart.options                                      | CartOptions[]       | array of options                                               |
| cart.items[].id                                   | int                 |                                                                |
| cart.items[].is_hidden_quantity                   | bool                |                                                                |
| cart.items[].url                                  | string              | Product url                                                    |
| cart.items[].quantity                             | int                 |                                                                |
| cart.items[].type                                 | string              | product type                                                   |
| cart.items[].product_price                        | MoneyTaxable        |                                                                |
| cart.items[].price                                | Money\|MoneyTaxable |                                                                |
| cart.items[].total                                | Money               |                                                                |
| cart.items[].product_id                           | int                 |                                                                |
| cart.items[].notes                                | string              |                                                                |
| cart.items[].can_add_note                         | bool                |                                                                |
| cart.items[].can_upload_file                      | bool                |                                                                |
| cart.items[].is_available                         | bool                |                                                                |
| cart.items[].offer                                | ?object             |                                                                |
| cart.items[].offer.discount                       | float               |                                                                |
| cart.items[].offer.is_free                        | bool                |                                                                |
| cart.items[].offer.names                          | ?string             | ex: `Buy 3 and the 4th on us, National Day`                    |
| cart.items[].donation                             | ?object             |                                                                |
| cart.items[].attachments                          | ?array              |                                                                |
| cart.items[].attachments[].id                     | int                 | image id, to be attache with the formData                      |
| cart.items[].attachments[].url                    | string              | image url                                                      |
| cart.items[].attachments[].product_id             | int                 |                                                                |
| cart.items[].attachments[].item_id                | int                 |                                                                |
| cart.items[].attachments[].name                   | int                 | image file name                                                |
#}

{#
  ELVA cart
  - Items as an editorial list (portrait thumbnails, hairline dividers) instead of boxed cards
  - Order summary printed on a "receipt" with a torn edge
  - Every class/id the cart script relies on is kept (item-total, item-price, #free-shipping, …)
#}
{% extends "layouts.master" %}
{% block content %}
    <div class="container elva-cart">
        {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>

        <header class="elva-cart__head">
            <h1 class="elva-cart__title">{{ trans('blocks.header.cart') }}</h1>
            {% if cart.items|length %}
                <span class="elva-cart__count" data-elva-cart-count aria-hidden="true">{{ cart.items|length }}</span>
            {% endif %}
        </header>

        <salla-conditional-offer data-testid="store-cart-conditional-offer"></salla-conditional-offer>

        <div class="elva-cart__layout">
            <div class="main-content elva-cart__items">
                {% hook 'cart:items.start' %}

                {% for item in cart.items %}
                    <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}" class="elva-citem-form">
                        <section data-testid="store-cart-item-{{ item.id }}" class="cart-item elva-citem">
                            <input type="hidden" name="id" value="{{ item.id }}">

                            <a href="{{ item.url }}" class="elva-citem__media" tabindex="-1" aria-hidden="true">
                                <img src="{{ item.product_image }}"
                                     alt="{{ item.product_name }}"
                                     loading="{{ loop.first ? 'eager' : 'lazy' }}">
                                <!-- free product ribbon -->
                                <span class="free-ribbon elva-citem__free {{ (item.price.getMoney().amount == 0 and item.has_discount) ? '' : 'hidden' }}">
                                    {{ trans('pages.loyalty_program.free_product') }}
                                </span>
                            </a>

                            <div class="elva-citem__body">
                                <div class="elva-citem__top">
                                    <h2 class="elva-citem__name">
                                        <a href="{{ item.url }}">{{ item.product_name }}</a>
                                    </h2>
                                    <salla-button data-testid="store-cart-delete-item" type="button" shape="icon" size="small" color="light" class="btn--delete elva-citem__remove" aria-label="{{ trans('blocks.elva.remove') }}"
                                            onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                                        <i class="sicon-cancel" aria-hidden="true"></i>
                                    </salla-button>
                                </div>

                                <div class="elva-citem__prices">
                                    <span data-testid="store-cart-item-price" class="item-price {{ item.has_discount ? 'text-red-800' : 'text-sm text-gray-500' }}" id="has_discount">{{ item.price|money }}</span>
                                    <span class="item-regular-price {{ item.offer ? '' : 'hidden' }}">{{ item.product_price|money }}</span>
                                    <span class="item-original-price {{ item.is_on_sale ? '' : 'hidden' }}" id="original_price">{{ item.original_price|money }}</span>
                                </div>

                                <p class="elva-citem__meta item-weight-row {{ item.weight_label ? '' : 'hidden' }}">{{ trans('pages.products.weight') }}
                                    <span class="item-weight">{{ item.weight_label }}</span>
                                </p>
                                <span class="old-offers elva-citem__offer {{ item.detailed_offers ? 'hidden' : '' }}">
                                    <i class="sicon-discount-calculator offer-icon {{ item.offer ? '' : 'hidden' }}" aria-hidden="true"></i>
                                    <span class="offer-name {{ item.offer ? '' : 'hidden' }}">{{ item.offer.names }}</span>
                                </span>
                                {# Cart Item Offers #}
                                <salla-cart-item-offers
                                    quantity="{{ item.quantity }}"
                                    item-id="{{ item.id }}"
                                    product-price="{{ item.product_price }}"
                                    offers="{{ item.detailed_offers|json_encode }}"></salla-cart-item-offers>
                                {# End Cart Item offers #}

                                <div class="elva-citem__options">
                                    {% include 'pages.partials.product.options' with {product:item} %}
                                </div>

                                <div class="elva-citem__foot">
                                    {% if item.type == 'donating' %}
                                        <span></span>
                                    {% elseif item.is_hidden_quantity %}
                                        <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="Quantity"/>
                                        <span class="elva-citem__qty-static">{{ item.quantity }}</span>
                                    {% else %}
                                        <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}"
                                            class="elva-citem__qty"
                                            aria-label="Quantity"
                                            value="{{ item.quantity }}" name="quantity">
                                        </salla-quantity-input>
                                    {% endif %}
                                    {% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
                                    <p class="elva-citem__total">
                                        <span class="elva-citem__total-label">{{ trans('pages.cart.total') }}</span>
                                        <span data-testid="store-cart-item-total" class="item-total">{{ item.is_available ? item_total : trans('pages.cart.out_of_stock') }}</span>
                                    </p>
                                </div>
                            </div>
                        </section>
                    </form>
                {% else %}
                    <div data-testid="store-cart-empty" class="no-content-placeholder elva-cart__empty">
                        <svg class="elva-cart__empty-icon" width="72" height="72" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                            <path d="M32 14a5 5 0 1 1 5 5c-2 0-5 1.5-5 4v2"/>
                            <path d="M32 25 7 43c-2 1.5-1 4 1.5 4h47c2.5 0 3.5-2.5 1.5-4L32 25z"/>
                        </svg>
                        <p>{{ trans('pages.cart.empty_cart') }}</p>
                        <a data-testid="store-cart-back-home" href="{{ link('/') }}"
                           class="btn btn--outline-primary elva-cart__empty-btn">{{ trans('common.elements.back_home') }}</a>
                    </div>
                {% endfor %}

                {% if cart.options|length %}
                  <div class="cart-options">
                    {% for product_option in cart.options %}
                      <form class="first:pt-5 relative" onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ product_option.id }}">
                        <input type="hidden" name="id" value="{{ product_option.id }}">
                        <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
                        {% include 'pages.partials.product.options' with { product: product_option } %}
                      </form>
                    {% endfor %}
                  </div>
                {% endif %}

                <salla-offer data-testid="store-cart-offer"></salla-offer>

                {% hook 'cart:items.end' %}
            </div>

            {% hook 'cart:summary.start' %}

            <!-- sidebar -->
            {% if cart.items|length %}
                <aside class="elva-cart__aside">
                    {% set is_free = cart.free_shipping_bar.has_free_shipping %}
                    <div class="elva-ship {{ cart.free_shipping_bar ? '' : 'hidden' }}" id="free-shipping">
                        <p class="elva-ship__msg">
                            <i class="sicon-shipping-fast {{ theme.is_rtl ? 'flip-x' : '' }}" aria-hidden="true"></i>
                            <span>
                                <b class="shipping-item">{{ trans('pages.cart.free_shipping') }}</b>
                                <span class="shipping-item" id="free-shipping-msg">{{ (is_free
                                    ? trans('pages.cart.has_free_shipping')
                                    : trans('pages.cart.free_shipping_alert', {'amount': cart.free_shipping_bar.remaining|money}))
                                    | raw }}</span>
                                <span class="emoji {{ is_free ? '' : 'hidden' }}" id="free-shipping-applied">🎉</span>
                            </span>
                        </p>
                        <div class="elva-ship__track {{ is_free ? ' hidden' : '' }}" id="free-shipping-bar">
                            <div class="progress-bg elva-ship__fill" style="width:{{ cart.free_shipping_bar.percent }}%"></div>
                        </div>
                    </div>

                    {% if loyalty %}
                        <salla-loyalty-panel
                            data-testid="store-cart-loyalty"
                            prize-points='{{ loyalty.prize.points }}'
                            prize-title='{{ loyalty.prize.title }}'>
                        </salla-loyalty-panel>
                    {% endif %}

                    <div id="cart-gifting" class="elva-cart__panel {{ gift.enabled ? '' : 'hidden' }}">
                        <salla-gifting data-testid="store-cart-gifting" id="salla-gifting" widget-title="{{ trans("pages.cart.gift_widget_title") }}" widget-subtitle="{{ gift.text }}" {{ gift.type }}-products vertical></salla-gifting>
                    </div>

                    {# the receipt: coupon + totals + checkout #}
                    <div class="elva-receipt">
                        <h2 class="elva-receipt__title">{{ trans('blocks.elva.order_summary') }}</h2>

                        {% if store.settings.cart.apply_coupon_enabled %}
                            <div class="elva-receipt__coupon">
                                {% hook 'cart:coupon.start' %}
                                <salla-cart-coupons data-testid="store-cart-coupons"></salla-cart-coupons>
                                {% hook 'cart:coupon.end' %}
                            </div>
                        {% endif %}

                        {% hook 'cart:summary-card.start' %}
                        <salla-cart-summary-card data-testid="store-cart-summary"></salla-cart-summary-card>
                        {% hook 'cart:summary-card.end' %}
                    </div>
                    {% hook 'cart:summary.end' %}

                    <!-- Tiered Offer Component -->
                    <salla-tiered-offer data-testid="store-cart-tiered-offer"></salla-tiered-offer>
                </aside>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
