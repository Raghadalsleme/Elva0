{#
| Variable              | Type    | Description                                                         |
|-----------------------|---------|---------------------------------------------------------------------|
| component             | object  | Merchant settings for fields from twilight.json `components` entry  |
| component.image       | ?string | Portrait image (1000×1250)                                          |
| component.eyebrow     | ?string |                                                                     |
| component.title       | ?string |                                                                     |
| component.text        | ?string |                                                                     |
| component.button_text | ?string |                                                                     |
| component.url         | ?string |                                                                     |
| component.dark        | bool    | Plum background instead of the light page background               |
| component.reverse     | bool    | Put the image on the other side                                     |
| position              | int     | Sorting number start from zero                                      |
ELVA brand story — image with an offset hairline frame next to the brand text.
#}
<section component-id="{{ componentId }}" data-testid="store-home-elva-story"
         class="s-block elva-story{{ component.dark ? ' s-block--full-bg elva-story--dark' : '' }}">
    <div class="container elva-story__inner{{ component.reverse ? ' elva-story--reverse' : '' }}">
        <div class="elva-story__media" data-elva-reveal="side">
            {% if component.image %}
                <img class="elva-story__img" src="{{ component.image }}" alt="{{ component.title }}" loading="lazy" width="1000" height="1250">
            {% else %}
                <div class="elva-story__placeholder" aria-hidden="true">E</div>
            {% endif %}
        </div>

        <div class="elva-story__text" data-elva-stagger="0.1">
            {% if component.eyebrow %}
                <p class="elva-eyebrow">{{ component.eyebrow }}</p>
            {% endif %}
            {% if component.title %}
                <h2>{{ component.title }}</h2>
            {% endif %}
            <div class="elva-ornament elva-ornament--start" aria-hidden="true"><span></span></div>
            {% if component.text %}
                <p>{{ component.text|nl2br }}</p>
            {% endif %}
            {% if component.button_text and component.url %}
                <a href="{{ component.url }}" class="elva-btn {{ component.dark ? 'elva-btn--cream' : 'elva-btn--plum' }}">{{ component.button_text }}</a>
            {% endif %}
        </div>
    </div>
</section>
